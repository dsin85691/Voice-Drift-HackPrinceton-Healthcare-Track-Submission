#!/usr/bin/env python3
"""Pre-commit hook (spec 8): reject files > 5 MB and paths containing 'androids'.
Install:  copy to .git/hooks/pre-commit  (or: git config core.hooksPath tools)"""
import subprocess
import sys
from pathlib import Path

files = subprocess.run(["git", "diff", "--cached", "--name-only", "--diff-filter=ACM"],
                       capture_output=True, text=True).stdout.split()
bad = []
for f in files:
    if "androids" in f.lower():
        bad.append(f"{f}: path contains 'androids' (dataset-derived data stays on Drive)")
    elif Path(f).exists() and Path(f).stat().st_size > 5 * 1024 * 1024:
        bad.append(f"{f}: larger than 5 MB")
if bad:
    print("commit blocked:\n  " + "\n  ".join(bad))
    sys.exit(1)
